// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/powershell
{
	"name": "PowerShell",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"features": {
		"ghcr.io/devcontainers/features/powershell:2": {},
		"ghcr.io/devcontainers/features/azure-cli:1": {
			"installBicep": true,
			"version": "latest",
			"bicepVersion": "latest"
		},
		"ghcr.io/devcontainers/features/aws-cli:1": {},
		"ghcr.io/devcontainers/features/python:1": {},
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/devcontainers-extra/features/apt-packages:1": {
            "packages": "openssl,strongswan-pki,libcap2-bin,iputils-ping,traceroute,iputils-tracepath,bind9-dnsutils"
        }
	},

	"postCreateCommand": "sudo setcap cap_net_raw+p /usr/bin/ping && sudo chsh vscode -s \"$(which pwsh)\" && npm install -g @opencode/cli && npm install -g @fission-ai/openspec@latest && npm install -g prettier && bash .devcontainer/install-stax2aws.sh",

	// Configure tool-specific properties.
	"customizations": {
		// Configure properties specific to VS Code.
		"vscode": {
			// Set *default* container specific settings.json values on container create.
			"settings": { 
				"terminal.integrated.defaultProfile.linux": "pwsh"
			},
			
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"ms-vscode.powershell",
                "EditorConfig.EditorConfig",
                "esbenp.prettier-vscode",
				"sst-dev.opencode",
				"anthropic.claude-code",
				"ms-azuretools.vscode-bicep",
				"ms-azuretools.vscode-azureresourcegroups",
				"mhutchie.git-graph",
				"jebbs.plantuml"
			]
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"

	"runArgs": ["--cap-add=NET_RAW"]
}
